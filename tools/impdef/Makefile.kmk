## @file
# IMPDEF makefile.
#

SUB_DEPTH = ../..
include $(KBUILD_PATH)/subheader.kmk

BLDPROGS           += impdef
impdef_TEMPLATE     = OdinBin

# @todo: the need of this for BLDPROGS looks like a kBuild bug to me
impdef_INST         = $(STAGE_BIN)
impdef_INSTTYPE     = stage

# libstdc++ (<string>) chokes on the lowercase min/max macros of include/incl_gcc/stdlib.h
impdef_DEFS         = ODIN_NO_MINMAX

impdef_INCS         = \
    ../common

impdef_SOURCES      = \
    ImpDef.cpp \
    ImpDef.def

impdef_LIBS         = \
    $(PATH_STAGE_LIB)/common.lib

include $(FILE_KBUILD_SUB_FOOTER)
